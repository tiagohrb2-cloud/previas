# =====================================================================
# DropFlow — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o arquivo preenchido.
# =====================================================================

# URL pública da aplicação (usada no redirect do OAuth e no webhook)
APP_URL=http://localhost:3000

# PostgreSQL. No Supabase: Project Settings > Database > Connection string (URI).
# Use a conexão "Session pooler" ou direta (porta 5432) para migrações.
DATABASE_URL=postgresql://dropflow:dropflow@localhost:5432/dropflow
# true para exigir SSL (Supabase exige). false para Postgres local.
DATABASE_SSL=false

# Chave de criptografia de tokens e credenciais (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Token de uso único para criar o primeiro administrador em /setup.
# Gere um valor aleatório longo; após criar o admin a página fica bloqueada.
SETUP_TOKEN=

# Segredo para o endpoint de processamento da fila (/api/cron/process).
CRON_SECRET=

# ---------------------------------------------------------------------
# Mercado Livre — crie o aplicativo em https://developers.mercadolivre.com.br
# (Minhas aplicações). Redirect URI: ${APP_URL}/api/ml/oauth/callback
# URL de notificações: ${APP_URL}/api/webhooks/mercadolivre?key=${ML_WEBHOOK_KEY}
# ---------------------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Segredo aleatório incluído na URL de notificações (o ML não assina webhooks).
ML_WEBHOOK_KEY=
# Endereços oficiais (só altere se a documentação oficial indicar mudança)
ML_AUTH_URL=https://auth.mercadolivre.com.br/authorization
ML_API_URL=https://api.mercadolibre.com
ML_SITE_ID=MLB

# Fuso horário de exibição
APP_TIMEZONE=America/Sao_Paulo
